# ========================================================
# LUMITECH.ID - ENVIRONMENT CONFIGURATION
# ========================================================

# Aiven MySQL Cloud Database Credentials
AIVEN_MYSQL_HOST=mysql-xxxxxxxx-your-project.aivencloud.com
AIVEN_MYSQL_PORT=24582
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=your_aiven_password_here
AIVEN_MYSQL_DATABASE=defaultdb
AIVEN_MYSQL_SSL_MODE=REQUIRED

# Opsional: Path ke CA Certificate Aiven jika diperlukan
# AIVEN_MYSQL_SSL_CA=config/ca.pem
