{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/produk.php",
      "destination": "/produk.html",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/index.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/img/logo-icon.png"
    },
    {
      "source": "/produk",
      "destination": "/produk.html"
    },
    {
      "source": "/katalog",
      "destination": "/produk.html"
    },
    {
      "source": "/katalog.html",
      "destination": "/produk.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
