{
  "version": 2,
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/img/logo-icon.png"
    },
    {
      "source": "/produk",
      "destination": "/api/produk.php"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.php"
    }
  ]
}