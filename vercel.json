{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/img/logo-icon.png"
    },
    {
      "source": "/produk.php",
      "destination": "/produk.html"
    },
    {
      "source": "/produk.php",
      "destination": "/produk.html"
    },
    {
      "source": "/index.php",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
