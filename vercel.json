{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": [
        "admin/**",
        "config/**",
        "data/**",
        "Layout/**"
      ]
    }
  },
  "redirects": [
    {
      "source": "/produk.php",
      "destination": "/produk.html",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/index.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/img/logo-icon.png"
    },
    {
      "source": "/admin",
      "destination": "/api/admin.php"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin.php"
    },
    {
      "source": "/produk",
      "destination": "/produk.html"
    },
    {
      "source": "/katalog",
      "destination": "/produk.html"
    },
    {
      "source": "/katalog.html",
      "destination": "/produk.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
